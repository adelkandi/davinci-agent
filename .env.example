# DaVinci — environment variable placeholders
# Copy to .env.local and fill in real values. Never commit real secrets.

# --- OpenAI (required) ---
OPENAI_API_KEY=

# --- Twilio WhatsApp Sandbox (required for Plan A) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Demo phone numbers (required for demo) ---
CUSTOMER_DEMO_PHONE=
CREW_DEMO_PHONE=

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=

# --- Trigger.dev (OPTIONAL — only wire in if clearly useful) ---
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# --- Google Cloud Run (OPTIONAL — deployment target; Vercel is fallback) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
